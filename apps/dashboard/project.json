{
  "name": "dashboard",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "apps/dashboard/src",
  "targets": {
    "dev": {
      "command": "npm run dev",
      "options": { "cwd": "apps/dashboard" }
    },
    "build": {
      "command": "npm run build",
      "options": { "cwd": "apps/dashboard" }
    },
    "check": {
      "command": "npm run check",
      "options": { "cwd": "apps/dashboard" }
    }
  }
}
