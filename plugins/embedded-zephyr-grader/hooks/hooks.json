{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/scripts/run-tool-pipeline-async.sh",
            "async": true,
            "timeout": 300000,
            "description": "Launch static analysis tools after successful west build"
          }
        ]
      }
    ]
  }
}
