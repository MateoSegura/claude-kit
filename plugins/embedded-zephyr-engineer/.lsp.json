{
  "clangd": {
    "command": "clangd",
    "args": [
      "--background-index",
      "--clang-tidy",
      "--header-insertion=iwyu",
      "--compile-commands-dir=build"
    ],
    "extensionToLanguage": {
      ".c": "c",
      ".h": "c"
    }
  },
  "pyright-langserver": {
    "command": "pyright-langserver",
    "args": ["--stdio"],
    "extensionToLanguage": {
      ".py": "python"
    }
  }
}