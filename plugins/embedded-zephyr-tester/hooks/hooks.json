{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/scripts/protect-source-files.sh",
            "description": "Warn when tester agent tries to modify non-test source files (src/ but not tests/)"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/scripts/validate-test-file.sh",
            "description": "Validate test file structure: check for ZTEST_SUITE, proper includes, testcase.yaml presence"
          }
        ]
      }
    ]
  }
}
