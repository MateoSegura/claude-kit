{
  "svelte-language-server": {
    "command": "svelteserver",
    "args": ["--stdio"],
    "extensionToLanguage": {
      ".svelte": "svelte"
    }
  },
  "typescript-language-server": {
    "command": "typescript-language-server",
    "args": ["--stdio"],
    "extensionToLanguage": {
      ".ts": "typescript",
      ".js": "javascript",
      ".tsx": "typescriptreact"
    }
  },
  "tailwindcss-language-server": {
    "command": "tailwindcss-language-server",
    "args": ["--stdio"],
    "extensionToLanguage": {
      ".css": "css"
    }
  }
}
