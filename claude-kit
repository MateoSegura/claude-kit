def cmd_debug(args: list) -> None:
    CLAUDE_DIR = pathlib.Path.home() / ".claude"
    RULES_DIR  = CLAUDE_DIR / "rules"
    DEBUGFILE  = RULES_DIR / "claude-kit-debug.md"

    DEBUG_CONTENT = """\
# claude-kit Debug Output

Print a visible debug line **before** every skill invocation, agent spawn,
or plugin component usage.

| Event | Format |
|-------|--------|
| Skill invocation | `> **[kit:route]** "intent" → skill-name · match: reason` |
| Agent spawn | `> **[kit:agent]** spawning agent-name · mode: permissionMode` |
| Hook trigger | `> **[kit:hook]** event → description · result: allowed/blocked` |
| Knowledge skill | `> **[kit:skill]** using skill-name for what` |

At the start of each action turn, print a session summary:

> **[kit:session]** core: *list* | teams: *list or "none"* | system: *list or "none"* | profile: *assistant/pair/autonomous/custom* | routing: active

Determine the active profile by checking section 4 of `~/.claude/rules/claude-kit.md` for "Behavioral Profile (ProfileName)".
"""

    is_on = DEBUGFILE.exists()

    # Read the active profile from manifest
    manifest = _read_manifest()
    active_profile = manifest.get("profile", "none") if manifest else "none"

    if not args:
        state = col(C.G, "on") if is_on else col(C.DIM, "off")
        p()
        p(f"  Debug mode: {state}    Profile: {col(C.CY, active_profile)}")
        p()
        if is_on:
            p(f"  Claude will print {col(C.W, '[kit:*]')} blocks before every")
            p(f"  skill invocation, agent spawn, and hook trigger.")
            p()
            p(f"  {col(C.DIM, 'Managed via ~/.claude/rules/claude-kit-debug.md')}")
        else:
            p(f"  Run {col(C.CY, 'claude-kit debug on')} to enable debug output.")
        p()
        return

    action = args[0].lower()

    if action == "on":
        if is_on:
            p()
            p(f"  Debug mode is already {col(C.G, 'on')}.")
            p()
            return

        RULES_DIR.mkdir(parents=True, exist_ok=True)
        DEBUGFILE.write_text(DEBUG_CONTENT)
        p()
        p(f"  {col(C.G, '✓')} Debug mode {col(C.G, 'on')}")
        p(f"  {col(C.DIM, 'Created ~/.claude/rules/claude-kit-debug.md')}")
        p()

    elif action == "off":
        if not is_on:
