# ── Interactive menu ──────────────────────────────────────────────────────────

def _read_key() -> str:
    """Read a single keypress, returning arrow keys as 'up'/'down' and Enter as 'enter'."""
    import tty as _tty, termios as _termios
    fd = sys.stdin.fileno()
    old = _termios.tcgetattr(fd)
    try:
        _tty.setraw(fd)
        ch = sys.stdin.read(1)
        if ch == '\x1b':
            seq = sys.stdin.read(2)
            if seq == '[A': return 'up'
            if seq == '[B': return 'down'
            return 'esc'
        if ch in ('\r', '\n'):
            return 'enter'
        if ch == '\x03':
            raise KeyboardInterrupt
        return ch
    finally:
        _termios.tcsetattr(fd, _termios.TCSADRAIN, old)


def _select_menu(options: list, indent: int = 4) -> int:
    """Show an interactive arrow-key menu. Returns selected index, or -1 on ESC.

    Each option is a dict with 'icon', 'label', 'tagline'.
    All labels are padded to the same width for alignment.
    """
    if not options:
        return -1
    cur = 0
    pad = " " * indent
    max_label = max(len(o["label"]) for o in options)

    def render():
        for i, opt in enumerate(options):
            icon    = opt.get("icon", " ")
            label   = opt["label"].ljust(max_label)
            tagline = opt.get("tagline", "")
            if i == cur:
                prefix = f"{pad}  {col(C.CY, '❯')} {icon}  {col(C.W, label)}  {col(C.DIM, '—')} {tagline}"
            else:
                prefix = f"{pad}    {icon}  {col(C.DIM, label)}  {col(C.DIM, '—')} {tagline}"
            print(prefix)

    # Hide cursor
    sys.stdout.write('\033[?25l')
    sys.stdout.flush()

    render()

    try:
        while True:
            key = _read_key()
            if key == 'up':
                cur = (cur - 1) % len(options)
            elif key == 'down':
                cur = (cur + 1) % len(options)
            elif key == 'enter':
                break
            elif key == 'esc':
                cur = -1
                break
            # Move cursor up N lines and re-render
            sys.stdout.write(f'\033[{len(options)}A\r')
            render()
    except KeyboardInterrupt:
        sys.stdout.write('\033[?25h')
        sys.stdout.flush()
        p()
        p(f"{pad}{col(C.DIM, 'Cancelled.')}")
        p()
        sys.exit(0)
    finally:
        # Show cursor
        sys.stdout.write('\033[?25h')
        sys.stdout.flush()

    return cur


def _select_single(question: str, options: list, indent: int = 4) -> int:
    """Ask a question with selectable options. Returns selected index, or -1 on ESC."""
    pad = " " * indent
    p(f"{pad}{col(C.W, question)}")
    p()
    idx = _select_menu(options, indent)
    p()
    return idx


