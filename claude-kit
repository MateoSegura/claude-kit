# ── Colors ───────────────────────────────────────────────────────────────────

class C:
    R   = '\033[0;31m'
    G   = '\033[0;32m'
    Y   = '\033[0;33m'
    CY  = '\033[0;36m'
    W   = '\033[1;37m'
    DIM = '\033[2m'
    N   = '\033[0m'

def col(color: str, text: str) -> str:
    return f"{color}{text}{C.N}"

def p(text: str = "") -> None:
    print(text)

