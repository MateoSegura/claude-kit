def cmd_validate(args: list) -> None:
    validator = INSTALL_DIR / "scripts" / "validate-plugins.py"
    if not validator.exists():
        print(f"Error: validator not found at {validator}")
        sys.exit(1)

    if not args or args[0] == "--all":
        script_args = ["--all"]
    elif args[0] == "--changed":
        script_args = ["--changed"]
    elif not args[0].startswith("-"):
        script_args = ["--plugin", args[0]]
    else:
        print("Usage: claude-kit validate [<name> | --all | --changed]")
        sys.exit(1)

    extra = [a for a in args[1:] if a.startswith("--")]
    result = subprocess.run(
        [sys.executable, str(validator)] + script_args + extra,
        cwd=str(INSTALL_DIR),
    )
    sys.exit(result.returncode)

