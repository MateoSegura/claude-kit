def _read_manifest():
    if not MANIFEST_FILE.exists():
        return None
    try:
        return json.loads(MANIFEST_FILE.read_text())
    except Exception:
        return None

def _write_manifest(manifest: dict) -> None:
    MANIFEST_FILE.parent.mkdir(parents=True, exist_ok=True)
    MANIFEST_FILE.write_text(json.dumps(manifest, indent=2) + "\n")

# ── cmd_setup ─────────────────────────────────────────────────────────────────

def cmd_setup(args: list) -> None:
    CLAUDE_DIR      = pathlib.Path.home() / ".claude"
    RULES_DIR       = CLAUDE_DIR / "rules"
    SETTINGS_FILE   = CLAUDE_DIR / "settings.json"
    STATUSLINE_DEST = CLAUDE_DIR / "statusline-command.sh"
    STATUSLINE_SRC  = INSTALL_DIR / "scripts" / "statusline-command.sh"
    AUTOROUTE_DEST  = RULES_DIR / "claude-kit-autoroute.md"
    AUTOROUTE_SRC   = INSTALL_DIR / "scripts" / "rules" / "claude-kit-autoroute.md"

    timestamp = datetime.now().strftime("%Y%m%d_%H%M%S")
    BACKUP_DIR.mkdir(parents=True, exist_ok=True)
    CLAUDE_DIR.mkdir(parents=True, exist_ok=True)

    manifest = _read_manifest() or {
        "version": "1",
        "backups": {},
        "files_added": [],
        "settings_keys": {},
    }
    manifest["timestamp"] = timestamp
    manifest["kit_ref"] = _git(["rev-parse", "--short", "HEAD"]) or "?"

    p()
    p(f"  {col(C.W, 'claude-kit setup')}")
    p(f"  {col(C.DIM, '─' * 40)}")
    p()

    # ── Statusline ─────────────────────────────────────────────────────────────

    p(f"  {col(C.W, 'Status line')}  {col(C.DIM, 'ctx %, tokens, model in Claude Code footer')}")
    p()

    skip_statusline = False

    if SETTINGS_FILE.exists():
        try:
            settings = json.loads(SETTINGS_FILE.read_text())
            existing_cmd = settings.get("statusLine", {}).get("command", "")
            expected_cmd = f"bash {STATUSLINE_DEST}"
            if existing_cmd and existing_cmd != expected_cmd:
                p(f"  {col(C.Y, '!')} Existing statusLine detected:")
                p(f"      {col(C.DIM, existing_cmd)}")
                p()
                p(f"    {col(C.W, '[o]')} overwrite  {col(C.W, '[s]')} skip  {col(C.DIM, '(default: o)')}")
                choice = input("    Choice: ").strip().lower() or "o"
                if choice == "s":
                    skip_statusline = True
                    p(f"  {col(C.DIM, 'Skipped.')}")
                else:
                    p(f"  {col(C.Y, 'Overwriting — backup created.')}")
                p()
        except Exception:
            pass

    if not skip_statusline:
        # Backup settings.json before first touch
        if SETTINGS_FILE.exists() and str(SETTINGS_FILE) not in manifest["backups"]:
            backup_path = BACKUP_DIR / f"settings.json.{timestamp}"
            shutil.copy2(SETTINGS_FILE, backup_path)
            manifest["backups"][str(SETTINGS_FILE)] = str(backup_path)
            p(f"  {col(C.DIM, f'Backed up settings.json → {backup_path.name}')}")

        # Install script
        shutil.copy2(STATUSLINE_SRC, STATUSLINE_DEST)
        STATUSLINE_DEST.chmod(0o755)
        if str(STATUSLINE_DEST) not in manifest["files_added"]:
            manifest["files_added"].append(str(STATUSLINE_DEST))

        # Update settings.json
        try:
            settings = json.loads(SETTINGS_FILE.read_text()) if SETTINGS_FILE.exists() else {}
        except Exception:
            settings = {}

        settings["statusLine"] = {"type": "command", "command": f"bash {STATUSLINE_DEST}"}
        SETTINGS_FILE.write_text(json.dumps(settings, indent=2) + "\n")

        keys = manifest["settings_keys"].setdefault(str(SETTINGS_FILE), [])
        if "statusLine" not in keys:
            keys.append("statusLine")

        p(f"  {col(C.G, '✓')} Status line installed")
        p()

    # ── Auto-routing rules ────────────────────────────────────────────────────

    p(f"  {col(C.W, 'Auto-routing')}  {col(C.DIM, 'natural language → skill invocation')}")
    p()

    skip_autoroute = False

    if AUTOROUTE_DEST.exists():
        p(f"  {col(C.DIM, 'Already installed — skipping.')}")
        skip_autoroute = True
        p()

    if not AUTOROUTE_SRC.exists():
        p(f"  {col(C.Y, '!')} Source rules file not found — skipping.")
        skip_autoroute = True
        p()

    if not skip_autoroute:
        RULES_DIR.mkdir(parents=True, exist_ok=True)
        shutil.copy2(AUTOROUTE_SRC, AUTOROUTE_DEST)
        if str(AUTOROUTE_DEST) not in manifest["files_added"]:
            manifest["files_added"].append(str(AUTOROUTE_DEST))
        p(f"  {col(C.G, '✓')} Auto-routing rules installed")
        p()

    _write_manifest(manifest)

    p(f"  {col(C.DIM, '─' * 40)}")
    p(f"  {col(C.G, 'Setup complete.')}")
    p()
    p(f"  Undo anytime:  {col(C.CY, 'claude-kit restore')}")
    p()

# ── cmd_restore ───────────────────────────────────────────────────────────────

def cmd_restore(args: list) -> None:
    manifest = _read_manifest()
    if not manifest:
        p()
        p(f"  {col(C.Y, 'No setup manifest found.')} Nothing to restore.")
        p()
        return

    p()
    p(f"  {col(C.W, 'claude-kit restore')}")
    p(f"  {col(C.DIM, '─' * 40)}")
    p()

    backups       = manifest.get("backups", {})
    files_added   = manifest.get("files_added", [])
    settings_keys = manifest.get("settings_keys", {})

    if not backups and not files_added:
        p(f"  {col(C.DIM, 'Nothing to restore.')}")
        p()
        return

    if backups:
        p(f"  {col(C.W, 'Will restore:')}")
        p()
        for orig, bak in backups.items():
            orig_path = pathlib.Path(orig)
            bak_path  = pathlib.Path(bak)
            keys = settings_keys.get(orig, [])
            keys_str = f"  {col(C.DIM, '(keys: ' + ', '.join(keys) + ')')}" if keys else ""
            p(f"    {col(C.CY, orig_path.name)}{keys_str}")

            # Diff: current vs what we'll restore
            if bak_path.exists() and orig_path.exists():
                try:
                    cur_lines = orig_path.read_text().splitlines(keepends=True)
                    bak_lines = bak_path.read_text().splitlines(keepends=True)
                    diff = list(difflib.unified_diff(
                        cur_lines, bak_lines,
                        fromfile="current", tofile="backup", n=2
                    ))
                    if diff:
                        p(f"    {col(C.DIM, 'Diff (current → backup):')}")
                        for line in diff[:24]:
                            line = line.rstrip("\n")
                            if line.startswith("+") and not line.startswith("+++"):
                                p(f"      {col(C.G, line)}")
                            elif line.startswith("-") and not line.startswith("---"):
                                p(f"      {col(C.R, line)}")
                            else:
                                p(f"      {col(C.DIM, line)}")
                        if len(diff) > 24:
                            p(f"      {col(C.DIM, f'… {len(diff)-24} more lines')}")
                except Exception:
                    pass
            p()

    if files_added:
        p(f"  {col(C.W, 'Will remove:')}")
        p()
        for f in files_added:
            p(f"    {col(C.R, '-')} {f}")
        p()

    confirm = input(f"  {col(C.W, 'Proceed?')} [Y/n] ").strip().lower() or "y"
    if confirm not in ("y", "yes"):
        p()
        p(f"  {col(C.DIM, 'Aborted.')}")
        p()
        return

    p()

    for orig, bak in backups.items():
        orig_path = pathlib.Path(orig)
        bak_path  = pathlib.Path(bak)
        if bak_path.exists():
            shutil.copy2(bak_path, orig_path)
            p(f"  {col(C.G, '✓')} Restored {orig_path.name}")
        else:
            p(f"  {col(C.Y, '!')} Backup not found: {bak_path.name} — skipped")

    for f in files_added:
        fp = pathlib.Path(f)
        if fp.exists():
            fp.unlink()
            p(f"  {col(C.G, '✓')} Removed {fp.name}")

    # Also clean up debug mode if active (not tracked in manifest)
    debug_file = pathlib.Path.home() / ".claude" / "rules" / "claude-kit-debug.md"
    if debug_file.exists():
        debug_file.unlink()
        p(f"  {col(C.G, '✓')} Removed claude-kit-debug.md (debug mode was on)")

    MANIFEST_FILE.unlink(missing_ok=True)

    p()
    p(f"  {col(C.G, 'Restore complete.')} All setup changes reverted.")
    p()

# ── cmd_debug ─────────────────────────────────────────────────────────────────

def cmd_debug(args: list) -> None:
    CLAUDE_DIR  = pathlib.Path.home() / ".claude"
    RULES_DIR   = CLAUDE_DIR / "rules"
    DEBUG_DEST  = RULES_DIR / "claude-kit-debug.md"
    DEBUG_SRC   = INSTALL_DIR / "scripts" / "rules" / "claude-kit-debug.md"

    is_on = DEBUG_DEST.exists()

    if not args:
        state = col(C.G, "on") if is_on else col(C.DIM, "off")
        p()
        p(f"  Debug mode: {state}")
        p()
        if is_on:
            p(f"  Claude will print {col(C.W, '[kit:*]')} blocks before every")
            p(f"  skill invocation, agent spawn, and hook trigger.")
            p()
            p(f"  Turn off:  {col(C.CY, 'claude-kit debug off')}")
        else:
            p(f"  Turn on:   {col(C.CY, 'claude-kit debug on')}")
        p()
        return

    action = args[0].lower()

    if action == "on":
        if is_on:
            p()
            p(f"  Debug mode is already {col(C.G, 'on')}.")
            p()
            return
        if not DEBUG_SRC.exists():
            p()
            p(f"  {col(C.R, 'Error:')} Source debug rules file not found.")
            p(f"  Expected: {DEBUG_SRC}")
            p()
            return
        RULES_DIR.mkdir(parents=True, exist_ok=True)
        shutil.copy2(DEBUG_SRC, DEBUG_DEST)
        p()
        p(f"  {col(C.G, '✓')} Debug mode {col(C.G, 'on')}")
        p()
        p(f"  Claude will print {col(C.W, '[kit:*]')} blocks before every")
        p(f"  skill invocation, agent spawn, and hook trigger.")
        p()
        p(f"  Takes effect on next {col(C.CY, 'claude-kit --kit')} session.")
        p(f"  Turn off:  {col(C.CY, 'claude-kit debug off')}")
        p()

    elif action == "off":
        if not is_on:
            p()
            p(f"  Debug mode is already {col(C.DIM, 'off')}.")
            p()
            return
        DEBUG_DEST.unlink()
        p()
        p(f"  {col(C.G, '✓')} Debug mode {col(C.DIM, 'off')}")
        p()
        p(f"  Takes effect on next {col(C.CY, 'claude-kit --kit')} session.")
        p()

    else:
        p()
        p(f"  Usage: {col(C.CY, 'claude-kit debug [on|off]')}")
        p()

# ── cmd_feedback ──────────────────────────────────────────────────────────────

def _feedback_ask(prompt: str, required: bool = True) -> str:
    """Ask a single question in the feedback flow. Returns empty string on cancel."""
    try:
        p(f"  {col(C.W, prompt)}")
        answer = input(f"  {col(C.DIM, '>')} ").strip()
        if required and not answer:
            p(f"  {col(C.DIM, 'Skipped.')}")
            return ""
        return answer
    except (KeyboardInterrupt, EOFError):
        p()
        p(f"  {col(C.DIM, 'Cancelled.')}")
        return ""

def cmd_feedback() -> None:
    # Check gh is installed
    if not shutil.which("gh"):
        p()
        p(f"  {col(C.R, 'Error:')} GitHub CLI (gh) is required for feedback.")
        p(f"  Install it:  {col(C.CY, 'https://cli.github.com')}")
        p()
        sys.exit(1)

    # Check gh auth
    auth = subprocess.run(["gh", "auth", "status"], capture_output=True, text=True)
    if auth.returncode != 0:
        p()
        p(f"  {col(C.R, 'Error:')} Not authenticated with GitHub.")
        p(f"  Run:  {col(C.CY, 'gh auth login')}")
        p()
        sys.exit(1)

    p()
    p(f"  {col(C.W, 'claude-kit feedback')}")
    p(f"  {col(C.DIM, chr(0x2500) * 40)}")
    p()
    p(f"  {col(C.DIM, 'Press Ctrl+C at any time to cancel.')}")
    p()

    # 1. Type
    p(f"  {col(C.W, 'What kind of feedback?')}")
    p(f"    {col(C.CY, '1')}  Bug report")
    p(f"    {col(C.CY, '2')}  Feature request")
    p(f"    {col(C.CY, '3')}  General feedback")
    p()
    try:
        choice = input(f"  {col(C.DIM, '>')} ").strip()
    except (KeyboardInterrupt, EOFError):
        p()
        p(f"  {col(C.DIM, 'Cancelled.')}")
        p()
        return

    type_map = {"1": "bug", "2": "feature", "3": "feedback"}
    label_map = {"bug": "bug", "feature": "enhancement", "feedback": "feedback"}
    title_prefix = {"bug": "Bug", "feature": "Feature", "feedback": "Feedback"}
    fb_type = type_map.get(choice, "feedback")
    p()

    # 2. Summary
    summary = _feedback_ask("Describe it in one sentence:")
    if not summary:
        p()
        return
    p()

    # 3. Details (type-specific)
    details = ""
    if fb_type == "bug":
        details = _feedback_ask("What happened vs what you expected? (or press Enter to skip)", required=False)
    elif fb_type == "feature":
        details = _feedback_ask("What problem would this solve? (or press Enter to skip)", required=False)
    else:
        details = _feedback_ask("Any additional context? (or press Enter to skip)", required=False)
    p()

    # 4. Build the issue
    name  = _git(["config", "user.name"])  or "unknown"
    email = _git(["config", "user.email"]) or "unknown"
    ver   = _current_version()
    os_info = f"{platform.system()} {platform.release()}"
    date  = datetime.now().strftime("%Y-%m-%d")

    title = f"{title_prefix[fb_type]}: {summary[:60]}"

    body_lines = [f"## {title_prefix[fb_type]}", "", summary, ""]
    if details:
        if fb_type == "bug":
            body_lines += ["### Details", "", details, ""]
        elif fb_type == "feature":
            body_lines += ["### Motivation", "", details, ""]
        else:
            body_lines += ["### Details", "", details, ""]

    body_lines += [
        "---",
        f"**From:** {name} <{email}>",
        f"**Version:** {ver}",
        f"**OS:** {os_info}",
        f"**Date:** {date}",
    ]
    body = "\n".join(body_lines)

    # 5. Confirm
    p(f"  {col(C.DIM, chr(0x2500) * 40)}")
    p(f"  {col(C.W, 'Ready to submit:')}")
    p(f"    {col(C.CY, title)}")
    if details:
        p(f"    {col(C.DIM, details[:80])}")
    p()
    try:
        confirm = input(f"  Open issue? {col(C.DIM, '[Y/n]')} ").strip().lower()
    except (KeyboardInterrupt, EOFError):
        p()
        p(f"  {col(C.DIM, 'Cancelled.')}")
        p()
        return
    if confirm in ("n", "no"):
        p(f"  {col(C.DIM, 'Not submitted.')}")
        p()
        return

    # 6. Create issue
    label = label_map[fb_type]
    result = subprocess.run(
        ["gh", "issue", "create",
         "--repo", "MateoSegura/claude-kit",
         "--title", title,
         "--body", body,
         "--label", label],
        capture_output=True, text=True,
    )
    if result.returncode != 0:
        # Retry without label (label may not exist)
        result = subprocess.run(
            ["gh", "issue", "create",
             "--repo", "MateoSegura/claude-kit",
             "--title", title,
             "--body", body],
            capture_output=True, text=True,
        )

    if result.returncode == 0:
        url = result.stdout.strip()
        p()
        p(f"  {col(C.G, chr(0x2713))} Issue created!")
        p(f"  {col(C.CY, url)}")
        p()
    else:
        p()
        p(f"  {col(C.R, 'Error:')} Could not create issue.")
        stderr = result.stderr.strip()
        if stderr:
            p(f"  {col(C.DIM, stderr)}")
        p()
        sys.exit(1)

# ── cmd_roadmap ──────────────────────────────────────────────────────────────

def cmd_roadmap() -> None:
    roadmap_file = INSTALL_DIR / "ROADMAP.md"
    if not roadmap_file.exists():
        p()
        p(f"  {col(C.R, 'Error:')} ROADMAP.md not found.")
        p()
        sys.exit(1)

    p()
    p(f"  {col(C.W, 'claude-kit roadmap')}")
    p(f"  {col(C.DIM, chr(0x2500) * 40)}")

    section_color = C.N
    for line in roadmap_file.read_text().splitlines():
        stripped = line.strip()

        # Skip top-level heading
        if stripped.startswith("# ") and not stripped.startswith("## "):
            continue

        # Section headers
        if stripped.startswith("## "):
            label = stripped[3:].strip()
            if "in progress" in label.lower():
                section_color = C.CY
            elif "planned" in label.lower():
                section_color = C.Y
            elif "shipped" in label.lower():
                section_color = C.DIM
            else:
                section_color = C.N
            p()
            p(f"  {col(section_color, label)}")
            continue

        # Blank lines
        if not stripped:
            continue

        # Bullet items: - **Name** — detail
        if stripped.startswith("- **"):
            # Split on closing **
            rest_after_dash = stripped[2:]  # remove "- "
            bold_end = rest_after_dash.find("**", 2)
            if bold_end > 0:
                bold_text = rest_after_dash[2:bold_end]  # text inside **...**
                remainder = rest_after_dash[bold_end + 2:]  # after closing **
                p(f"    {col(C.W, bold_text)}{col(section_color, remainder)}")
            else:
                p(f"    {col(section_color, stripped[2:])}")
            continue

        # Indented continuation
        if line.startswith("  "):
            p(f"      {col(C.DIM, stripped)}")
            continue

    p()
    p(f"  {col(C.DIM, 'github.com/MateoSegura/claude-kit')}")
    p()

# ── cmd_uninstall ─────────────────────────────────────────────────────────────

def _remove_rc_lines(marker: str = "# claude-kit") -> list:
    """Remove the claude-kit PATH block from shell rc files. Returns cleaned files."""
    home = pathlib.Path.home()
    rc_files = [home / ".bashrc", home / ".zshrc", home / ".profile"]
    cleaned = []

    for rc in rc_files:
        if not rc.exists():
            continue
        try:
            lines = rc.read_text().splitlines(keepends=True)
            new_lines = []
            skip_next = False
            changed = False
            for i, line in enumerate(lines):
                if marker in line:
                    # Skip this comment line and the PATH line after it
                    skip_next = True
                    changed = True
                    # Also skip a blank line before the comment if present
                    if new_lines and new_lines[-1].strip() == "":
                        new_lines.pop()
                    continue
                if skip_next:
                    skip_next = False
                    if "local/bin" in line:
                        continue  # skip the PATH export line
                    else:
                        new_lines.append(line)  # wasn't the expected line, keep it
                else:
                    new_lines.append(line)

            if changed:
                rc.write_text("".join(new_lines))
                cleaned.append(rc.name)
        except Exception:
            pass

    return cleaned

def cmd_uninstall() -> None:
    bin_link = pathlib.Path.home() / ".local" / "bin" / "claude-kit"

    p()
    p(f"  {col(C.W, 'claude-kit uninstall')}")
    p(f"  {col(C.DIM, chr(0x2500) * 40)}")
    p()
    p(f"  This will remove:")
    p(f"    {col(C.R, chr(0x2022))} {INSTALL_DIR}  {col(C.DIM, '(plugins and CLI)')}")
    p(f"    {col(C.R, chr(0x2022))} {bin_link}  {col(C.DIM, '(symlink)')}")
    p(f"    {col(C.R, chr(0x2022))} PATH entries in shell rc files  {col(C.DIM, '(~/.bashrc, ~/.zshrc)')}")
    p()

    confirm = input(f"  {col(C.W, 'Continue?')} [y/N] ").strip().lower()
    if confirm not in ("y", "yes"):
        p(f"  {col(C.DIM, 'Aborted.')}")
        p()
        sys.exit(0)

    p()

    # 1. Remove PATH lines from rc files
    cleaned = _remove_rc_lines()
    for rc_name in cleaned:
        p(f"  {col(C.G, chr(0x2713))} Cleaned PATH entry from {rc_name}")

    # 2. Remove symlink
    if bin_link.is_symlink():
        bin_link.unlink()
        p(f"  {col(C.G, chr(0x2713))} Removed {bin_link}")

    # 3. Remove install directory
    shutil.rmtree(INSTALL_DIR)
    p(f"  {col(C.G, chr(0x2713))} Removed {INSTALL_DIR}")

    p()
    p(f"  {col(C.G, 'claude-kit uninstalled.')}")
    p()
    p(f"  {col(C.Y, 'IMPORTANT:')} Reload your shell to clear the cached command:")
    p(f"    {col(C.CY, 'exec $SHELL')}")
    p()
    p(f"  Or close and reopen your terminal.")
    p(f"  Until then, your shell may still try the old path.")
    p()

