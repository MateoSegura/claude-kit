def _merge_profile_settings(profile: dict, settings_file: pathlib.Path,
                            manifest: dict) -> None:
    """Deep-merge a profile's settings into settings.json."""
    try:
        settings = json.loads(settings_file.read_text()) if settings_file.exists() else {}
    except Exception:
        settings = {}

    profile_settings = profile.get("settings", {})

    # Deep merge permissions
    if "permissions" in profile_settings:
        perms = settings.setdefault("permissions", {})
        for key, val in profile_settings["permissions"].items():
            if isinstance(val, list):
                existing = set(perms.get(key, []))
                existing.update(val)
                perms[key] = sorted(existing)
            else:
                perms[key] = val

    # Deep merge sandbox
    if "sandbox" in profile_settings:
        sandbox = settings.setdefault("sandbox", {})
        for key, val in profile_settings["sandbox"].items():
            if isinstance(val, dict):
                sub = sandbox.setdefault(key, {})
                sub.update(val)
            else:
                sandbox[key] = val

    # Deep merge env
    if "env" in profile_settings:
        env = settings.setdefault("env", {})
        env.update(profile_settings["env"])

    settings_file.write_text(json.dumps(settings, indent=2) + "\n")

    # Track which keys we added
    keys = manifest["settings_keys"].setdefault(str(settings_file), [])
    for k in profile_settings:
        if k not in keys:
            keys.append(k)

    mode = profile_settings.get("permissions", {}).get("defaultMode", "default")
    p(f"    {col(C.G, '✓')} Settings updated  {col(C.DIM, '(' + mode + ' mode)')}")


def _get_behavior_content(profile: dict) -> str:
    """Return the behavioral rules content for a profile.

    For built-in profiles, reads from the behavior file on disk.
    For custom (questionnaire) profiles, returns the inline content.
    """
    # Custom profile: inline content
    if profile.get("_behavior_content"):
        return profile["_behavior_content"]

    # Built-in profile: read from file
    behavior_filename = profile.get("behavior_file")
    if behavior_filename:
        src = BEHAVIOR_DIR / behavior_filename
        if src.exists():
            return src.read_text()

    return ""


