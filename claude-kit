# ── Encryption ──────────────────────────────────────────────────────────────

# Temp directories created for decrypted plugins — cleaned up on exit.
_temp_dirs: list = []

def _get_key() -> str:
    """Assemble the encryption passphrase from split parts."""
    _p = ["cK9x@", "Vm4p", "Lw2R", "qJ7n", "Ht5Z", "bF3s"]
    return "".join(_p)

def _is_encrypted(plugin_dir: pathlib.Path) -> bool:
    """Check if a plugin has encrypted content (content.enc present, no plaintext dirs)."""
    return (plugin_dir / "content.enc").exists()

def _decrypt_plugin(plugin_dir: pathlib.Path, dest_dir: pathlib.Path) -> pathlib.Path:
    """Decrypt a plugin's content.enc into dest_dir, merging with metadata.

    Returns the path to the fully reconstructed plugin directory.
    """
    plugin_name = plugin_dir.name
    out_dir = dest_dir / plugin_name
    out_dir.mkdir(parents=True, exist_ok=True)

    # Copy metadata files (plaintext)
    cp_dir = plugin_dir / ".claude-plugin"
    if cp_dir.exists():
        shutil.copytree(cp_dir, out_dir / ".claude-plugin", dirs_exist_ok=True)

    enc_file = plugin_dir / "content.enc"
    if not enc_file.exists():
        return out_dir

    key = _get_key()

    # Decrypt with openssl → tar data in memory → extract
    result = subprocess.run(
        ["openssl", "enc", "-d", "-aes-256-cbc", "-pbkdf2", "-iter", "100000",
         "-pass", f"pass:{key}", "-in", str(enc_file)],
        capture_output=True,
    )
    if result.returncode != 0:
        print(f"Error: Failed to decrypt plugin '{plugin_name}'.", file=sys.stderr)
        sys.exit(1)

    with tarfile.open(fileobj=io.BytesIO(result.stdout), mode="r:gz") as tar:
        tar.extractall(path=str(out_dir))

    return out_dir

def _cleanup_temp() -> None:
    """Remove all temporary decryption directories."""
    for d in _temp_dirs:
        try:
            shutil.rmtree(d, ignore_errors=True)
        except Exception:
            pass

def _cleanup_stale_temps() -> None:
    """Remove stale ck-* temp dirs older than 1 hour (crash recovery)."""
    tmp = pathlib.Path(tempfile.gettempdir())
    cutoff = time.time() - 3600
    for d in tmp.glob("ck-*"):
        if d.is_dir():
            try:
                if d.stat().st_mtime < cutoff:
                    shutil.rmtree(d, ignore_errors=True)
            except Exception:
                pass

def _setup_cleanup_handlers() -> None:
    """Register cleanup for temp dirs on exit and signals."""
    atexit.register(_cleanup_temp)
    prev_term = signal.getsignal(signal.SIGTERM)
    prev_int = signal.getsignal(signal.SIGINT)

    def _on_signal(signum, frame):
        _cleanup_temp()
        prev = prev_term if signum == signal.SIGTERM else prev_int
        if callable(prev):
            prev(signum, frame)
        sys.exit(128 + signum)

    signal.signal(signal.SIGTERM, _on_signal)
    signal.signal(signal.SIGINT, _on_signal)

