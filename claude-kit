# ── Plugin helpers ────────────────────────────────────────────────────────────

def plugin_version(plugin_dir: pathlib.Path) -> str:
    pjson = plugin_dir / ".claude-plugin" / "plugin.json"
    if not pjson.exists():
        return "?"
    try:
        return json.loads(pjson.read_text()).get("version", "?")
    except Exception:
        return "?"

def find_plugin_dir(name: str):
    for base in [PLUGINS_DIR, LOCAL_DIR]:
        d = base / name
        if d.is_dir():
            return d
    return None

def resolve_prefix(prefix: str) -> list:
    results = []
    for base in [PLUGINS_DIR, LOCAL_DIR]:
        if base.exists():
            for d in sorted(base.iterdir()):
                if d.is_dir() and d.name.startswith(prefix + "-"):
                    results.append(d.name)
    return results

def _read_ctl(plugin_dir: pathlib.Path) -> dict:
    """Read and return the ctl.json for a plugin, or empty dict if missing/invalid."""
    ctl = plugin_dir / ".claude-plugin" / "ctl.json"
    if not ctl.exists():
        return {}
    try:
        return json.loads(ctl.read_text())
    except Exception:
        return {}

def resolve_companions(plugin_dir: pathlib.Path) -> list:
    return _read_ctl(plugin_dir).get("companions", [])

def resolve_core_plugins(domain) -> list:
    """Find core-* plugins to auto-load.

    - domain="always": loads unconditionally (infrastructure plugins like core-kit)
    - domain="universal": loads when any team domain is active
    - domain=<name>: loads when team domain matches
    """
    matches = []
    for base in [PLUGINS_DIR, LOCAL_DIR]:
        if not base.exists():
            continue
        for d in sorted(base.iterdir()):
            if not d.is_dir() or not d.name.startswith("core-"):
                continue
            ctl = _read_ctl(d)
            ctl_domain = ctl.get("domain")
            if ctl_domain == "always":
                matches.append(d.name)
            elif domain and (ctl_domain == "universal" or ctl_domain == domain):
                matches.append(d.name)
    return sorted(set(matches))

def expand_kit(kit_name: str, seen: set) -> list:
    """Expand a kit name into deduplicated plugin names, companions first."""
    prefix_result = resolve_prefix(kit_name)
    plugin_names = prefix_result if prefix_result else [kit_name]

    team_result = []
    for pname in plugin_names:
        pdir = find_plugin_dir(pname)
        if pdir is None:
            print(f"Error: Kit '{pname}' not found in {PLUGINS_DIR}/ or {LOCAL_DIR}/",
                  file=sys.stderr)
            p()
            cmd_list()
            sys.exit(1)

        for comp in resolve_companions(pdir):
            if comp not in seen:
                comp_dir = find_plugin_dir(comp)
                if comp_dir is None:
                    print(f"Warning: Companion '{comp}' (required by '{pname}') not found.",
                          file=sys.stderr)
                else:
                    seen.add(comp)
                    team_result.append(comp)

        if pname not in seen:
            seen.add(pname)
            team_result.append(pname)

    # Auto-load core plugins matching the team's domain.
    # Determine domain from the first resolved plugin's ctl.json.
    domain = None
    for pname in plugin_names:
        pdir = find_plugin_dir(pname)
        if pdir:
            domain = _read_ctl(pdir).get("domain")
            if domain:
                break

    core_result = []
    # Auto-load core plugins: "always" plugins load unconditionally,
    # "universal" and domain-matching plugins load when a domain is active.
    for core_name in resolve_core_plugins(domain):
        if core_name not in seen:
            seen.add(core_name)
            core_result.append(core_name)

    # Core plugins go before team plugins (foundational knowledge first).
    return core_result + team_result

# ── Launch display ────────────────────────────────────────────────────────────

_ROLE_SUFFIXES = ("knowledge", "engineer", "grader", "tester", "debugger")

def _group_plugins(names: list) -> tuple:
    """Split plugin list into core group, team groups, and standalone plugins."""
    core: list = []
    groups: dict = {}
    standalone: list = []
    for name in names:
        parts = name.rsplit("-", 1)
        if len(parts) == 2 and parts[0] == "core":
            core.append(parts[1])
        elif len(parts) == 2 and parts[1] in _ROLE_SUFFIXES:
            groups.setdefault(parts[0], []).append(parts[1])
        else:
            standalone.append(name)
    return core, groups, standalone

def _print_launch_header(plugin_names: list) -> None:
    core, groups, standalone = _group_plugins(plugin_names)
    total       = len(plugin_names)
    n_kits      = len(groups) + len(standalone) + (1 if core else 0)
    kit_word    = "kit"    if n_kits == 1 else "kits"
    plugin_word = "plugin" if total  == 1 else "plugins"

    p()
    p(f"  {col(C.W, 'claude-kit')}  {col(C.DIM, f'·  {n_kits} {kit_word}  ·  {total} {plugin_word}')}")
    p(f"  {col(C.DIM, '─' * 40)}")
    p()

    if core:
        sep = f"  {col(C.DIM, '·')}  "
        p(f"  {col(C.DIM, 'core')}  {col(C.DIM, '(auto-loaded)')}")
        p(f"    {sep.join(col(C.DIM, s) for s in core)}")
        p()

    for prefix, roles in groups.items():
        p(f"  {col(C.W, prefix)}")
        sep = f"  {col(C.DIM, '·')}  "
        p(f"    {sep.join(col(C.CY, r) for r in roles)}")
        p()

    for name in standalone:
        p(f"  {col(C.W, name)}")
        p()

    # Debug mode indicator
    debug_active = (pathlib.Path.home() / ".claude" / "rules" / "claude-kit-debug.md").exists()
    if debug_active:
        p(f"  {col(C.Y, 'debug')}  {col(C.DIM, '·  [kit:*] routing visible')}")
        p()

    p(f"  {col(C.DIM, '─' * 40)}")
    p(f"  {col(C.DIM, 'Launching Claude Code...')}")
    p()

# ── cmd_run ───────────────────────────────────────────────────────────────────

def cmd_run(args: list) -> None:
    kit_names = []
    plugin_names_raw = []  # --plugin/-p: exact plugin, no expansion
    model = "opus"
    skip_permissions = False
    passthrough = []  # flags/args forwarded to claude as-is

    # Flags we consume ourselves; everything else goes to claude.
    OUR_KV_FLAGS = {"--kit", "-k", "--plugin", "-p", "--model", "-m"}
    OUR_BOOL_FLAGS = {"--dangerously-skip-permissions", "--yolo", "-y"}

    i = 0
    while i < len(args):
        a = args[i]
        if a in ("--kit", "-k"):
            i += 1
            if i >= len(args):
                print("Error: --kit requires a name"); sys.exit(1)
            kit_names.append(args[i])
        elif a in ("--plugin", "-p"):
            i += 1
            if i >= len(args):
                print("Error: --plugin requires a name"); sys.exit(1)
            plugin_names_raw.append(args[i])
        elif a in ("--model", "-m"):
            i += 1
            if i >= len(args):
                print("Error: --model requires a value"); sys.exit(1)
            model = args[i]
        elif a in ("--dangerously-skip-permissions", "--yolo", "-y"):
            skip_permissions = True
        elif a.startswith("-"):
            # Unknown flag → pass through to claude
            passthrough.append(a)
        else:
            # Positional arg: if we haven't seen any passthrough flags yet
            # treat as kit name; otherwise it's a value for the previous flag.
            if passthrough and not passthrough[-1].startswith("--no"):
                passthrough.append(a)
            else:
                kit_names.append(a)
        i += 1

    if not kit_names and not plugin_names_raw:
        print("Error: Specify at least one kit with --kit <name> or plugin with --plugin <name>")
        p()
        cmd_list()
        sys.exit(1)

    seen: set = set()
    all_plugins: list = []

    # --plugin/-p: load exactly the named plugin, no prefix expansion,
    # no companion resolution, no core auto-loading.
    for pname in plugin_names_raw:
        pdir = find_plugin_dir(pname)
        if pdir is None:
            print(f"Error: Plugin '{pname}' not found in {PLUGINS_DIR}/ or {LOCAL_DIR}/",
                  file=sys.stderr)
            p()
            cmd_list()
            sys.exit(1)
        if pname not in seen:
            seen.add(pname)
            all_plugins.append(pname)

    # --kit/-k: full expansion (prefix match + companions + core auto-load).
    for name in kit_names:
        all_plugins.extend(expand_kit(name, seen))

    os.environ["CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS"] = "1"
    os.environ["CLAUDE_KIT_HOME"]        = str(INSTALL_DIR)
    os.environ["CLAUDE_KIT_BUNDLED_DIR"] = str(PLUGINS_DIR)
    os.environ["CLAUDE_KIT_LOCAL_DIR"]   = str(LOCAL_DIR)
    os.environ["CLAUDE_KIT_OUTPUT_DIR"]  = str(CK_OUTPUT_DIR)
    os.environ["CLAUDE_KIT_MODE"]        = CK_MODE

    LOCAL_DIR.mkdir(parents=True, exist_ok=True)

    claude_args = ["claude"]
    for pname in all_plugins:
        pdir = find_plugin_dir(pname)
        claude_args.extend(["--plugin-dir", str(pdir)])
    claude_args.extend(["--model", model])

    if skip_permissions:
        claude_args.append("--dangerously-skip-permissions")

    # Append any flags we don't handle (--resume, --continue, --verbose, etc.)
    claude_args.extend(passthrough)

    if not shutil.which("claude"):
        print("Error: Claude Code CLI ('claude') not found.")
        print("Install it first: https://claude.ai/code")
        sys.exit(1)

    _print_launch_header(all_plugins)

    if skip_permissions:
        p(f"  {col(C.Y, 'Warning:')} running with --dangerously-skip-permissions")
        p()

    os.execvp("claude", claude_args)

# ── cmd_list ──────────────────────────────────────────────────────────────────

def _list_section(dirs: list, label: str, empty_msg: str) -> None:
    """Render one section (Bundled or Local) with grouped plugins and versions.

    Plugins are split into three visual categories:
    - Teams: domain-specific coding plugins (cloud-python, embedded-zephyr, ...)
    - Core: shared knowledge plugins that auto-load (core-*)
    - System: meta-tools like system-maker and system-updater (system-*)

    In compact mode (default), versions and launch hints are hidden.
    In verbose mode (-v), the full output with versions and hints is shown.
    """
    p(f"  {col(C.W, label)}")
    p()
    if not dirs:
        p(f"  {empty_msg}")
        p()
        return

    # Classify into teams, core, system, and standalone
    teams: dict = {}
    core: list = []
    system: list = []
    standalones: list = []
    for d in dirs:
        if d.name.startswith("core-"):
            core.append(d)
        elif d.name.startswith("system-"):
            system.append(d)
        elif "-" in d.name:
            prefix = d.name.rsplit("-", 1)[0]
            teams.setdefault(prefix, []).append(d)
        else:
            standalones.append(d)

    sep = f"  {col(C.DIM, '·')}  "

    # ── Teams ──
    if teams:
        p(f"  {col(C.W, 'Teams')}")
        for prefix, members in sorted(teams.items()):
            if VERBOSE:
                p(f"  {col(C.DIM, 'claude-kit -k')} {col(C.W, prefix)}")
                parts_str = sep.join(
                    f"{col(C.CY, d.name[len(prefix)+1:])}  {col(C.DIM, plugin_version(d))}"
                    for d in members
                )
            else:
                p(f"  {col(C.W, prefix)}")
                parts_str = sep.join(
                    f"{col(C.CY, d.name[len(prefix)+1:])}"
                    for d in members
                )
            p(f"    {parts_str}")
            p()

    # ── Core ──
    if core:
        p(f"  {col(C.W, 'Core')}  {col(C.DIM, '·  auto-loaded by domain')}")
        if VERBOSE:
            parts_str = sep.join(
                f"{col(C.DIM, d.name.removeprefix('core-'))}  {col(C.DIM, plugin_version(d))}"
                for d in core
            )
        else:
            parts_str = sep.join(
                f"{col(C.DIM, d.name.removeprefix('core-'))}"
                for d in core
            )
        p(f"    {parts_str}")
        p()

    # ── System ──
    if system:
        p(f"  {col(C.W, 'System')}")
        if VERBOSE:
            parts_str = sep.join(
                f"{col(C.DIM, d.name.removeprefix('system-'))}  {col(C.DIM, plugin_version(d))}"
                for d in system
            )
        else:
            parts_str = sep.join(
                f"{col(C.DIM, d.name.removeprefix('system-'))}"
                for d in system
            )
        p(f"    {parts_str}")
        p()

    # ── Standalone ──
    if standalones:
        max_len = max(len(d.name) for d in standalones)
        for d in sorted(standalones, key=lambda x: x.name):
            pad = " " * (max_len - len(d.name))
            if VERBOSE:
                p(f"  {col(C.W, d.name)}{pad}  {col(C.DIM, plugin_version(d))}")
            else:
                p(f"  {col(C.W, d.name)}")
        p()

def cmd_list() -> None:
    bundled = sorted(
        (d for d in PLUGINS_DIR.iterdir() if d.is_dir()), key=lambda x: x.name
    ) if PLUGINS_DIR.exists() else []

    local = sorted(
        (d for d in LOCAL_DIR.iterdir() if d.is_dir()), key=lambda x: x.name
    ) if LOCAL_DIR.exists() else []

    total = len(bundled) + len(local)

    suffix = "s" if total != 1 else ""
    p()
    p(f"  {col(C.W, 'claude-kit')}  {col(C.DIM, f'·  {total} plugin{suffix}')}")
    p(f"  {col(C.DIM, '─' * 40)}")
    p()

    _list_section(bundled, "Bundled", col(C.DIM, "(none)"))

    p(f"  {col(C.DIM, '─' * 40)}")
    p()

    _list_section(
        local,
        "Local",
        f"{col(C.DIM, 'none — run')}  {col(C.CY, 'claude-kit --kit system-maker')}  {col(C.DIM, 'to create one')}",
    )


# ── cmd_update ────────────────────────────────────────────────────────────────

def _show_changelog(changelog_path: pathlib.Path,
                    since_tag: str | None = None,
                    latest_only: bool | None = None) -> None:
    """Parse CHANGELOG.md and display release entries newer than *since_tag*.

    If *since_tag* is ``None`` only the latest release entry is shown.
    When *latest_only* is ``True`` (default in non-verbose mode), only the
    first version section is shown even when multiple new versions exist.
    """
    if latest_only is None:
        latest_only = not VERBOSE

    try:
        text = changelog_path.read_text()
    except OSError:
        return

    # Normalise tag: "v0.3.1" → "0.3.1" for matching against changelog headers.
    since_ver = since_tag.lstrip("v") if since_tag else None

    lines = text.splitlines()
    entry_lines: list = []
    in_entry = False
    version_count = 0

    for line in lines:
        if line.startswith("## ["):
            ver_name = line.split("]")[0].replace("## [", "").strip()
            if ver_name.lower() == "unreleased":
                continue
            # Stop when we reach the version the user already had.
            if since_ver and ver_name == since_ver:
                break
            version_count += 1
            # In latest-only mode, stop after the first version section.
            if latest_only and version_count > 1:
                break
            in_entry = True
            entry_lines.append(line)
        elif in_entry:
            entry_lines.append(line)

    if not entry_lines:
        return

    p()
    p("  " + col(C.W, "What's new:"))
    p()

    # Merge continuation lines into their parent bullet, but drop sub-bullets.
    # Sub-bullets (  - `core-git` ...) and their continuations (4+ spaces)
    # are too granular for terminal display.  Check 4-space lines BEFORE
    # the 2-space merge so they don't get folded into the parent bullet.
    merged: list = []
    for line in entry_lines:
        if line.startswith("## [") or line.startswith("### ") or line.startswith("- "):
            merged.append(line)
        elif line.startswith("  - "):
            continue  # drop sub-bullets
        elif line.startswith("    "):
            continue  # drop sub-bullet continuation lines (4+ spaces)
        elif merged and merged[-1].startswith("- ") and line.startswith("  "):
            merged[-1] += " " + line.strip()
        else:
            merged.append(line)

    for line in merged:
        if line.startswith("## ["):
            ver = line.split("]")[0].replace("## [", "").strip()
            date = line.split("- ", 1)[1].strip() if "- " in line else ""
            p(f"    {col(C.CY, f'v{ver}')}  {col(C.DIM, date)}")
            p()
        elif line.startswith("### "):
            section = line.replace("### ", "").strip()
            p(f"    {col(C.W, section)}")
        elif line.startswith("- "):
            clean = line[2:].replace("**", "")
            wrapped = textwrap.wrap(clean, width=70)
            if wrapped:
                p(f"      {col(C.DIM, '•')} {wrapped[0]}")
                for cont in wrapped[1:]:
                    p(f"        {cont}")

def _git(args: list) -> str:
    return subprocess.run(
        ["git", "-C", str(INSTALL_DIR)] + args,
        capture_output=True, text=True
    ).stdout.strip()

def cmd_update() -> None:
    p()
    p(f"  {col(C.W, 'claude-kit update')}")
    p(f"  {col(C.DIM, '─' * 40)}")
    p()

    old_hash = _git(["rev-parse", "HEAD"]) or "?"
    # Use the nearest ancestor tag as the version baseline so the diff
    # matches the changelog.  If we read from the filesystem, commits
    # pulled between releases (tag A → untagged → tag B) would already
    # reflect intermediate bumps, hiding changes listed in the changelog.
    old_tag = _git(["describe", "--tags", "--abbrev=0"])
    old_versions: dict = {}
    if old_tag and PLUGINS_DIR.exists():
        for d in sorted(PLUGINS_DIR.iterdir()):
            if not d.is_dir():
                continue
            blob = _git(["show", f"{old_tag}:plugins/{d.name}/.claude-plugin/plugin.json"])
            if blob:
                try:
                    old_versions[d.name] = json.loads(blob).get("version", "?")
                except Exception:
                    old_versions[d.name] = plugin_version(d)
            # Plugin didn't exist at old tag — will show as "(new)"

    p(f"  {col(C.CY, 'Pulling from origin...')}")
    p()

    # Fetch tags with --force first so stale local tags (e.g. after an
    # upstream history rewrite) never block the subsequent pull.
    subprocess.run(
        ["git", "-C", str(INSTALL_DIR), "fetch", "--tags", "--force", "-q", "origin"],
        capture_output=True, text=True
    )

    result = subprocess.run(
        ["git", "-C", str(INSTALL_DIR), "pull", "--ff-only"],
        capture_output=True, text=True
    )

    if result.returncode != 0:
        p(f"  {col(C.R, '✗ Pull failed')}")
        p()
        for line in (result.stdout + result.stderr).splitlines():
            p(f"    {line}")
        p()
        sys.exit(1)

    # Determine version from the freshly-pulled CHANGELOG.md on disk.
    # We cannot call _current_version() here because the *running* Python
    # process still has the OLD function definition in memory — the pull
    # updated the file on disk but not the loaded bytecode.
    new_ver = "unknown"
    cl_path = INSTALL_DIR / "CHANGELOG.md"
    if cl_path.exists():
        try:
            for cl_line in cl_path.read_text().splitlines():
                if cl_line.startswith("## [") and "Unreleased" not in cl_line:
                    new_ver = "v" + cl_line.split("]")[0].replace("## [", "").strip()
                    break
        except OSError:
            pass
    if new_ver == "unknown":
        new_ver = _current_version()

    if "Already up to date" in (result.stdout + result.stderr):
        p(f"  {col(C.G, '✓ Already up to date')}  {col(C.DIM, f'({new_ver})')}")
        p()
        return

    n_commits = _git(["rev-list", f"{old_hash}..HEAD", "--count"]) or "?"
    commit_word = "commit" if n_commits == "1" else "commits"
    p(f"  {col(C.G, '✓ Updated to')} {col(C.W, new_ver)}  {col(C.DIM, f'({n_commits} new {commit_word})')}")
    p()

    # Show changelog first — this is what the user cares about most
    changelog = INSTALL_DIR / "CHANGELOG.md"
    if changelog.exists():
        _show_changelog(changelog, since_tag=old_tag)

    # Then show plugin version changes
    new_versions: dict = {}
    if PLUGINS_DIR.exists():
        for d in sorted(PLUGINS_DIR.iterdir()):
            if d.is_dir():
                new_versions[d.name] = plugin_version(d)

    all_names = set(old_versions) | set(new_versions)

    p(f"  {col(C.W, 'Plugin versions:')}")
    p()

    # Group by prefix (same logic as _list_section)
    groups: dict = {}
    standalones: list = []
    for name in sorted(all_names):
        if "-" in name:
            prefix = name.rsplit("-", 1)[0]
            groups.setdefault(prefix, []).append(name)
        else:
            standalones.append(name)

    sep = f"  {col(C.DIM, '·')}  "

    def _ver_entry(name: str, role: str) -> tuple:
        """Return (display_str, changed_bool) for a plugin version entry."""
        ov = old_versions.get(name)
        nv = new_versions.get(name)
        if nv is None:
            return f"{col(C.R, '−')} {role}  {col(C.R, '(removed)')}", True
        if ov is None:
            return f"{col(C.G, '+')} {col(C.CY, role)}  {col(C.G, nv)}  {col(C.DIM, '(new)')}", True
        if ov != nv:
            return f"{col(C.Y, '↑')} {col(C.CY, role)}  {col(C.Y, f'{ov} → {nv}')}", True
        return f"{col(C.DIM, f'{role} {nv}')}", False

    for prefix, members in sorted(groups.items()):
        entries = [_ver_entry(n, n[len(prefix)+1:]) for n in members]
        # In non-verbose mode, skip groups where nothing changed
        if not VERBOSE:
            changed = [e for e, c in entries if c]
            if not changed:
                continue
            p(f"  {col(C.W, prefix)}")
            p(f"    {sep.join(changed)}")
        else:
            p(f"  {col(C.W, prefix)}")
            parts = [e for e, _ in entries]
            p(f"    {sep.join(parts)}")
        p()

    for name in sorted(standalones):
        ov = old_versions.get(name)
        nv = new_versions.get(name)
        if nv is None:
            p(f"  {col(C.R, '−')} {name}  {col(C.R, '(removed)')}")
        elif ov is None:
            p(f"  {col(C.G, '+')} {col(C.CY, name)}  {col(C.G, nv)}  {col(C.DIM, '(new)')}")
        elif ov != nv:
            p(f"  {col(C.Y, '↑')} {col(C.CY, name)}  {col(C.Y, f'{ov} → {nv}')}")
        else:
            p(f"  {col(C.DIM, f'{name} {nv}')}")

    # Auto-update installed files if they changed
    # Note: claude-kit.md is NOT auto-synced because it has user-specific
    # behavioral profile content appended during setup. Only the statusline
    # (a standalone script) is safe to auto-sync.
    auto_sync = [
        ("statusline-command.sh",
         INSTALL_DIR / "scripts" / "statusline-command.sh",
         pathlib.Path.home() / ".claude" / "statusline-command.sh"),
    ]
    synced = []
    for label, src, dest in auto_sync:
        if dest.exists() and src.exists():
            if src.read_bytes() != dest.read_bytes():
                shutil.copy2(src, dest)
                synced.append(label)

    if synced:
        p()
        p(f"  {col(C.W, 'Scripts:')}")
        p()
        for label in synced:
            p(f"    {col(C.Y, '↑')} {col(C.W, label)}  {col(C.Y, 'updated')}")

    # Clean up stale files from previous versions (pre-1.0 layout changes)
    RULES_DIR = pathlib.Path.home() / ".claude" / "rules"
    stale_files = [
        RULES_DIR / "claude-kit-autoroute.md",   # replaced by claude-kit.md
        RULES_DIR / "claude-kit-behavior.md",     # merged into claude-kit.md section 4
        RULES_DIR / "plan-protocol.md",           # merged into claude-kit.md section 2
    ]
    removed = []
    for stale in stale_files:
        if stale.exists():
            stale.unlink()
            removed.append(stale.name)

    if removed:
        p()
        p(f"  {col(C.W, 'Cleanup:')}")
        p()
        for name in removed:
            p(f"    {col(C.R, '-')} {col(C.DIM, name)}  {col(C.DIM, '(stale, replaced by claude-kit.md)')}")

    p()
    p(f"  {col(C.G, 'Done.')}")
    p()

# ── cmd_version ───────────────────────────────────────────────────────────────

def _current_version() -> str:
    """Return the version of the local claude-kit installation.

    Resolution order:
    1. Exact tag at HEAD (rare — only right after tagging on this branch)
    2. Latest versioned entry in CHANGELOG.md (authoritative after squash-merge,
       because the release tag lives on the now-deleted feature branch commit)
    3. Nearest ancestor tag via ``git describe`` (last resort)
    """
    tag = _git(["tag", "--points-at", "HEAD", "--sort=-version:refname"])
    if tag:
        return tag.splitlines()[0]
    cl = INSTALL_DIR / "CHANGELOG.md"
    if cl.exists():
        try:
            for line in cl.read_text().splitlines():
                if line.startswith("## [") and "Unreleased" not in line:
                    return "v" + line.split("]")[0].replace("## [", "").strip()
        except OSError:
            pass
    desc = _git(["describe", "--tags", "--abbrev=0"])
    if desc:
        return desc
    return _git(["rev-parse", "--short", "HEAD"]) or "unknown"

def _remote_version() -> str:
    """Return the latest semver tag on origin/main, or short hash if no tags exist."""
    tag = _git(["tag", "--points-at", "origin/main", "--sort=-version:refname"])
    if tag:
        return tag.splitlines()[0]
    tag = _git(["tag", "--sort=-version:refname", "--list", "v*"])
    if tag:
        return tag.splitlines()[0]
    return _git(["rev-parse", "--short", "origin/main"]) or "?"

def cmd_version() -> None:
    local_ver = _current_version()

    p()
    p(f"  {col(C.W, 'claude-kit')}  {col(C.CY, local_ver)}")
    p()
    p(f"  {col(C.DIM, 'Checking for updates...')}")

    fetch = subprocess.run(
        ["git", "-C", str(INSTALL_DIR), "fetch", "--tags", "-q", "origin"],
        capture_output=True, text=True
    )

    if fetch.returncode != 0:
        p(f"  {col(C.Y, '! Could not reach remote — skipping update check.')}")
        p()
        return

    remote_ver = _remote_version()

    if local_ver == remote_ver:
        p(f"  {col(C.G, '✓')} Up to date  {col(C.DIM, f'({local_ver})')}")
    else:
        p(f"  {col(C.Y, '↑')} Update available: {col(C.W, remote_ver)}  {col(C.DIM, f'(current: {local_ver})')}")
        p()
        p(f"  Run {col(C.CY, 'claude-kit update')} to upgrade.")
    p()

