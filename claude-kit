def main() -> None:
    global VERBOSE
    args = sys.argv[1:]

    if not args or args[0] in ("help", "--help", "-h"):
        cmd_help()
        return

    cmd  = args[0]
    rest = args[1:]

    # Extract -v/--verbose for subcommands (not for launch mode via cmd_run)
    subcommands = {"list", "update", "version", "setup", "restore", "debug",
                   "validate", "uninstall", "feedback", "roadmap"}
    if cmd in subcommands:
        if "-v" in rest or "--verbose" in rest:
            VERBOSE = True
            rest = [a for a in rest if a not in ("-v", "--verbose")]

    # Auto-enable verbose if debug mode is active
    if (pathlib.Path.home() / ".claude" / "rules" / "claude-kit-debug.md").exists():
        VERBOSE = True

    # Show setup banner for user installs where setup hasn't been run
    skip_banner = {"setup", "uninstall", "restore", "help"}
    if cmd not in skip_banner:
        _maybe_show_setup_banner()

    dispatch = {
        "list":      lambda: cmd_list(),
        "update":    lambda: cmd_update(),
        "version":   lambda: cmd_version(),
        "setup":     lambda: cmd_setup(rest),
        "restore":   lambda: cmd_restore(rest),
        "debug":     lambda: cmd_debug(rest),
        "validate":  lambda: cmd_validate(rest),
        "uninstall": lambda: cmd_uninstall(),
        "feedback":  lambda: cmd_feedback(),
        "roadmap":   lambda: cmd_roadmap(),
    }

    if cmd in dispatch:
        dispatch[cmd]()
        if cmd not in {"help"}:
            _maybe_show_tip()
    else:
        # Any flag or positional not matching a subcommand goes to cmd_run,
        # which separates claude-kit flags from claude passthrough flags.
        cmd_run(args)

if __name__ == "__main__":
    main()
