def _run_questionnaire() -> dict:
    """Run the Advanced questionnaire and compose a custom profile from answers."""
    p(f"    {col(C.DIM, 'Answer each question using ↑/↓ arrows and Enter.')}")
    p()

    answers = {}
    for q in _QUESTIONS:
        idx = _select_single(q["question"], q["options"])
        if idx == -1:
            return None  # user cancelled
        answers[q["key"]] = idx

    return _compose_profile(answers)


def _compose_profile(answers: dict) -> dict:
    """Compose a profile dict from questionnaire answers."""
    profile = {
        "name": "custom",
        "label": "Custom",
        "icon": "⚙️",
        "tagline": "Custom profile from questionnaire",
        "settings": {"permissions": {}},
    }

    perms = profile["settings"]["permissions"]

    # ── Permission mode ───────────────────────────────────────────────────────
    involvement = answers.get("involvement", 0)
    file_edits  = answers.get("file_edits", 0)

    if involvement == 2 or file_edits == 2:
        perms["defaultMode"] = "bypassPermissions"
    elif involvement == 1 or file_edits == 1:
        perms["defaultMode"] = "acceptEdits"
    else:
        perms["defaultMode"] = "default"

    # ── Allow list ────────────────────────────────────────────────────────────
    allow = ["Read", "Glob", "Grep"]

    shell = answers.get("shell_commands", 0)
    if shell >= 1:
        allow.extend([
            "Bash(git status)", "Bash(git diff *)", "Bash(git log *)",
            "Bash(git add *)", "Bash(git commit *)",
            "Bash(npm run *)", "Bash(npm test *)", "Bash(npx *)",
            "Bash(make *)", "Bash(python *)", "Bash(cargo *)", "Bash(go *)",
        ])
    if shell >= 1:
        allow.extend([
            "Task", "TaskCreate", "TaskUpdate", "TaskList", "TaskGet",
            "TeamCreate", "TeamDelete", "SendMessage",
        ])
    if shell >= 2 or file_edits >= 1:
        allow.extend(["Edit", "Write"])

    perms["allow"] = sorted(set(allow))

    # ── Deny list ─────────────────────────────────────────────────────────────
    deny = []
    dangerous = answers.get("dangerous_ops", 0)
    if dangerous <= 1:
        deny.extend(["Bash(rm -rf *)", "Bash(git push --force *)", "Bash(git reset --hard *)"])
    if dangerous == 1:
        deny.extend(["Bash(git push * main)", "Bash(git push * master)"])

    if deny:
        perms["deny"] = sorted(set(deny))

    # ── Sandbox ───────────────────────────────────────────────────────────────
    env = answers.get("environment", 0)
    if env == 1:
        profile["settings"]["sandbox"] = {
            "enabled": True,
            "autoAllowBashIfSandboxed": True,
        }

    # ── Agent teams ────────────────────────────────────────────────────────────
    profile["settings"]["env"] = {"CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1"}

    # ── Compose behavior rules ────────────────────────────────────────────────
    rules = ["# claude-kit Behavioral Profile: Custom", ""]

    # Decision protocol
    rules.append("## Decision Protocol")
    rules.append("")
    arch = answers.get("architecture", 0)
    if arch == 0:
        rules.append("- ALWAYS present your plan before making changes. List the files you intend to modify.")
        rules.append("- When multiple approaches exist, present the top 2 with tradeoffs. Let the user choose.")
        rules.append("- Ask before creating, deleting, or modifying files outside the current request scope.")
    elif arch == 1:
        rules.append("- Make tactical decisions independently: variable names, function structure, error handling, test organization.")
        rules.append("- IMPORTANT: Ask before architectural decisions: new dependencies, new modules, schema changes, API changes.")
        rules.append("- Fix test failures and lint errors without asking. Report what you fixed.")
    else:
        rules.append("- YOU MUST make all decisions independently. Do not use AskUserQuestion.")
        rules.append("- Proceed with the most reasonable approach. Document your choice in a commit message.")
        rules.append("- If requirements are ambiguous, implement the most common interpretation and note the assumption.")
    rules.append("")

    # Error recovery
    rules.append("## Error Recovery")
    rules.append("")
    recovery = answers.get("error_recovery", 0)
    if recovery == 0:
        rules.append("- When you encounter an error, show the error output and propose a fix. Wait for confirmation.")
    elif recovery == 1:
        rules.append("- When a command fails, read the full error, attempt a fix, and retry. Up to 3 attempts.")
        rules.append("- After 3 failed attempts, stop and report what you tried and your suspected root cause.")
        rules.append("- Never retry the exact same command expecting different results.")
    else:
        rules.append("- IMPORTANT: When a command fails, read the FULL error output before attempting a fix.")
        rules.append("- Try up to 3 different approaches. Each attempt must be meaningfully different.")
        rules.append("- Use WebSearch to research unfamiliar errors before guessing at fixes.")
        rules.append("- After 3 failed attempts, write a failure report and move to the next task.")
        rules.append("- Never retry the exact same command expecting different results.")
    rules.append("")

    # Web research
    research = answers.get("web_research", 0)
    if research >= 1:
        rules.append("## Research Protocol")
        rules.append("")
        if research == 1:
            rules.append("- Use WebSearch when encountering unfamiliar APIs, libraries, or error messages.")
            rules.append("- Verify function signatures against official docs when unsure.")
        else:
            rules.append("- Before implementing with any library or API, use WebSearch to find current documentation.")
            rules.append("- Verify function signatures and required parameters against official docs.")
            rules.append("- When an approach seems wrong, search for the recommended pattern before continuing.")
        rules.append("")

    # Verification
    rules.append("## Verification")
    rules.append("")
    thorough = answers.get("thoroughness", 0)
    if thorough == 0:
        rules.append("- Run tests when asked or when the task specifically requires it.")
    elif thorough == 1:
        rules.append("- Run tests after implementation. Fix failures before reporting completion.")
        rules.append("- Run the linter if available. Fix issues before reporting completion.")
    else:
        rules.append("- IMPORTANT: After every implementation, run: linter, type checker, relevant tests, build.")
        rules.append("- Fix all failures before considering the task complete.")
        rules.append("- If a test is flaky, note it and move on.")
    rules.append("")

    # Communication
    rules.append("## Communication")
    rules.append("")
    comm = answers.get("communication", 0)
    if comm == 0:
        rules.append("- Explain your reasoning for each significant decision in 1-2 sentences.")
        rules.append("- Summarize what you changed after each set of modifications.")
    elif comm == 1:
        rules.append("- State what you are doing and why in one sentence before doing it.")
        rules.append("- Report progress at task boundaries: file saved, tests passing, commit created.")
    else:
        rules.append("- Do not explain reasoning in conversation. Put rationale in code comments and commit messages.")
        rules.append("- Only report errors and task completions.")
    rules.append("")

    # Loop prevention (for autonomous-leaning configs)
    if involvement >= 2 or recovery >= 2:
        rules.append("## Loop Prevention")
        rules.append("")
        rules.append("- Never read the same file more than twice in a single task.")
        rules.append("- If you find yourself attempting the same fix repeatedly, try a fundamentally different approach.")
        rules.append("- Maximum 3 retries per subtask. After that, document and move on.")
        rules.append("")

    profile["_behavior_content"] = "\n".join(rules)
    return profile


# ── cmd_setup ─────────────────────────────────────────────────────────────────

def cmd_setup(args: list) -> None:
    CLAUDE_DIR      = pathlib.Path.home() / ".claude"
    RULES_DIR       = CLAUDE_DIR / "rules"
    SETTINGS_FILE   = CLAUDE_DIR / "settings.json"
    STATUSLINE_DEST = CLAUDE_DIR / "statusline-command.sh"
    STATUSLINE_SRC  = INSTALL_DIR / "scripts" / "statusline-command.sh"
    KITRULES_DEST   = RULES_DIR / "claude-kit.md"
    KITRULES_SRC    = INSTALL_DIR / "scripts" / "rules" / "claude-kit.md"
    # Legacy files that the consolidated claude-kit.md replaces
    # Stale files from previous versions that claude-kit.md replaces.
    # NOTE: claude-kit-debug.md is NOT stale — it's the active debug mechanism.
    LEGACY_RULES    = [
        RULES_DIR / "claude-kit-autoroute.md",
        RULES_DIR / "claude-kit-behavior.md",
        RULES_DIR / "plan-protocol.md",
    ]

    # ── Parse setup-specific flags ────────────────────────────────────────────
    profile_name = None
    profile_file = None
    rest = list(args)

    i = 0
    while i < len(rest):
        if rest[i] == "--profile":
            if i + 1 >= len(rest):
                p(f"  {col(C.R, 'Error:')} --profile requires a name (assistant, pair, autonomous)")
                sys.exit(1)
            profile_name = rest[i + 1]
            rest = rest[:i] + rest[i + 2:]
        elif rest[i] == "-f":
            if i + 1 >= len(rest):
                p(f"  {col(C.R, 'Error:')} -f requires a path to a profile JSON file")
                sys.exit(1)
            profile_file = rest[i + 1]
            rest = rest[:i] + rest[i + 2:]
        else:
            i += 1

    timestamp = datetime.now().strftime("%Y%m%d_%H%M%S")
    BACKUP_DIR.mkdir(parents=True, exist_ok=True)
    CLAUDE_DIR.mkdir(parents=True, exist_ok=True)

    manifest = _read_manifest() or {
        "version": "1",
        "backups": {},
        "files_added": [],
        "settings_keys": {},
    }
    manifest["timestamp"] = timestamp
    manifest["kit_ref"] = _git(["rev-parse", "--short", "HEAD"]) or "?"

    p()
    p(f"  {col(C.W, 'claude-kit setup')}")
    p(f"  {col(C.DIM, '─' * 40)}")
    p()

    # ── Backup settings.json before any modifications ─────────────────────────
    if SETTINGS_FILE.exists() and str(SETTINGS_FILE) not in manifest["backups"]:
        backup_path = BACKUP_DIR / f"settings.json.{timestamp}"
        shutil.copy2(SETTINGS_FILE, backup_path)
        manifest["backups"][str(SETTINGS_FILE)] = str(backup_path)
        p(f"  {col(C.DIM, f'Backed up settings.json → {backup_path.name}')}")
        p()

    # ── 1. Profile selection ──────────────────────────────────────────────────

    p(f"  {col(C.W, 'Profile')}  {col(C.DIM, 'how Claude works with you')}")
    p()

    selected_profile = None

    if profile_file:
        # Non-interactive: load from file
        selected_profile = _load_profile_file(profile_file)
        p(f"    Loading profile from {col(C.CY, profile_file)}")
        p()
    elif profile_name:
        # Non-interactive: load by name
        selected_profile = _load_profile(profile_name)
        p(f"    Using profile: {col(C.CY, profile_name)}")
        p()
    else:
        # Interactive: show menu
        profiles = _load_all_profiles()
        menu_options = [
            {"icon": pr["icon"], "label": pr["label"], "tagline": pr["tagline"]}
            for pr in profiles
        ]
        menu_options.append({
            "icon": "⚙️",
            "label": "Advanced",
            "tagline": "Answer detailed questions to build a custom profile",
        })

        p(f"    {col(C.DIM, 'How should Claude work with you?')}")
        p()
        choice = _select_menu(menu_options)
        p()

        if choice == -1:
            p(f"    {col(C.DIM, 'Cancelled.')}")
            p()
            return
        elif choice < len(profiles):
            selected_profile = profiles[choice]
        # else: Advanced — handled below

    # ── Apply profile or run questionnaire ────────────────────────────────────

    behavior_content = ""

    if selected_profile:
        _merge_profile_settings(selected_profile, SETTINGS_FILE, manifest)
        behavior_content = _get_behavior_content(selected_profile)
        manifest["profile"] = selected_profile.get("name", "unknown")
    else:
        # Advanced questionnaire
        p(f"  {col(C.W, 'Advanced configuration')}")
        p()
        custom = _run_questionnaire()
        if custom is None:
            p(f"    {col(C.DIM, 'Cancelled.')}")
            p()
            return
        _merge_profile_settings(custom, SETTINGS_FILE, manifest)
        behavior_content = _get_behavior_content(custom)
        manifest["profile"] = "custom"

    p()

    # ── 2. Status line ────────────────────────────────────────────────────────

    p(f"  {col(C.W, 'Status line')}  {col(C.DIM, 'ctx %, tokens, model in Claude Code footer')}")
    p()

    skip_statusline = False

    if SETTINGS_FILE.exists():
        try:
            settings = json.loads(SETTINGS_FILE.read_text())
            existing_cmd = settings.get("statusLine", {}).get("command", "")
            expected_cmd = f"bash {STATUSLINE_DEST}"
            if existing_cmd and existing_cmd != expected_cmd:
                p(f"    {col(C.Y, '!')} Existing statusLine detected:")
                p(f"        {col(C.DIM, existing_cmd)}")
                p()
                p(f"      {col(C.W, '[o]')} overwrite  {col(C.W, '[s]')} skip  {col(C.DIM, '(default: o)')}")
                choice = input("      Choice: ").strip().lower() or "o"
                if choice == "s":
                    skip_statusline = True
                    p(f"    {col(C.DIM, 'Skipped.')}")
                else:
                    p(f"    {col(C.Y, 'Overwriting.')}")
                p()
        except Exception:
            pass

    if not skip_statusline:
        # Install script
        shutil.copy2(STATUSLINE_SRC, STATUSLINE_DEST)
        STATUSLINE_DEST.chmod(0o755)
        if str(STATUSLINE_DEST) not in manifest["files_added"]:
            manifest["files_added"].append(str(STATUSLINE_DEST))

        # Update settings.json
        try:
            settings = json.loads(SETTINGS_FILE.read_text()) if SETTINGS_FILE.exists() else {}
        except Exception:
            settings = {}

        settings["statusLine"] = {"type": "command", "command": f"bash {STATUSLINE_DEST}"}
        SETTINGS_FILE.write_text(json.dumps(settings, indent=2) + "\n")

        keys = manifest["settings_keys"].setdefault(str(SETTINGS_FILE), [])
        if "statusLine" not in keys:
            keys.append("statusLine")

        p(f"    {col(C.G, '✓')} Status line installed")
        p()

    # ── 3. System rules (routing, debug, plan protocol) ──────────────────────

    p(f"  {col(C.W, 'System rules')}  {col(C.DIM, 'routing + debug + plan protocol + behavior')}")
    p()

    skip_kitrules = False

    if not KITRULES_SRC.exists():
        p(f"    {col(C.Y, '!')} Source rules file not found — skipping.")
        skip_kitrules = True
        p()

    if not skip_kitrules:
        RULES_DIR.mkdir(parents=True, exist_ok=True)

        # Remove legacy individual rules files that claude-kit.md replaces
        for legacy in LEGACY_RULES:
            if legacy.exists():
                legacy.unlink()
                p(f"    {col(C.DIM, f'Removed legacy {legacy.name}')}")
                # Clean from manifest
                legacy_str = str(legacy)
                if legacy_str in manifest["files_added"]:
                    manifest["files_added"].remove(legacy_str)

        # Copy base rules (sections 1-3) and append behavioral profile (section 4)
        base_content = KITRULES_SRC.read_text()
        if behavior_content:
            # Strip the top-level heading from the behavior file since it becomes section 4
            lines = behavior_content.strip().splitlines()
            if lines and lines[0].startswith("# "):
                # Replace "# claude-kit Behavioral Profile: X" with "## 4. Behavioral Profile"
                profile_label = manifest.get("profile", "custom").title()
                lines[0] = f"## 4. Behavioral Profile ({profile_label})"
            assembled = base_content.rstrip() + "\n\n---\n\n" + "\n".join(lines) + "\n"
        else:
            assembled = base_content

        KITRULES_DEST.write_text(assembled)

        if str(KITRULES_DEST) not in manifest["files_added"]:
            manifest["files_added"].append(str(KITRULES_DEST))
        p(f"    {col(C.G, '✓')} System rules installed  {col(C.DIM, '(sections 1-4)')}")
        p()

    _write_manifest(manifest)

    p(f"  {col(C.DIM, '─' * 40)}")
    p(f"  {col(C.G, 'Setup complete.')}  {col(C.DIM, 'Profile: ' + manifest.get('profile', '?'))}")
    p()
    p(f"  Undo anytime:    {col(C.CY, 'claude-kit restore')}")
    p(f"  Change profile:  {col(C.CY, 'claude-kit setup --profile <name>')}")
    p()

# ── cmd_restore ───────────────────────────────────────────────────────────────

def cmd_restore(args: list) -> None:
    manifest = _read_manifest()
    if not manifest:
        p()
        p(f"  {col(C.Y, 'No setup manifest found.')} Nothing to restore.")
        p()
        return

    p()
    p(f"  {col(C.W, 'claude-kit restore')}")
    p(f"  {col(C.DIM, '─' * 40)}")
    p()

    backups       = manifest.get("backups", {})
    files_added   = manifest.get("files_added", [])
    settings_keys = manifest.get("settings_keys", {})

    if not backups and not files_added:
        p(f"  {col(C.DIM, 'Nothing to restore.')}")
        p()
        return

    if backups:
        p(f"  {col(C.W, 'Will restore:')}")
        p()
        for orig, bak in backups.items():
            orig_path = pathlib.Path(orig)
            bak_path  = pathlib.Path(bak)
            keys = settings_keys.get(orig, [])
            keys_str = f"  {col(C.DIM, '(keys: ' + ', '.join(keys) + ')')}" if keys else ""
            p(f"    {col(C.CY, orig_path.name)}{keys_str}")

            # Diff: current vs what we'll restore
            if bak_path.exists() and orig_path.exists():
                try:
                    cur_lines = orig_path.read_text().splitlines(keepends=True)
                    bak_lines = bak_path.read_text().splitlines(keepends=True)
                    diff = list(difflib.unified_diff(
                        cur_lines, bak_lines,
                        fromfile="current", tofile="backup", n=2
                    ))
                    if diff:
                        p(f"    {col(C.DIM, 'Diff (current → backup):')}")
                        for line in diff[:24]:
                            line = line.rstrip("\n")
                            if line.startswith("+") and not line.startswith("+++"):
                                p(f"      {col(C.G, line)}")
                            elif line.startswith("-") and not line.startswith("---"):
                                p(f"      {col(C.R, line)}")
                            else:
                                p(f"      {col(C.DIM, line)}")
                        if len(diff) > 24:
                            p(f"      {col(C.DIM, f'… {len(diff)-24} more lines')}")
                except Exception:
                    pass
            p()

    if files_added:
        p(f"  {col(C.W, 'Will remove:')}")
        p()
        for f in files_added:
            p(f"    {col(C.R, '-')} {f}")
        p()

    confirm = input(f"  {col(C.W, 'Proceed?')} [Y/n] ").strip().lower() or "y"
    if confirm not in ("y", "yes"):
        p()
        p(f"  {col(C.DIM, 'Aborted.')}")
        p()
        return

    p()

    for orig, bak in backups.items():
        orig_path = pathlib.Path(orig)
        bak_path  = pathlib.Path(bak)
        if bak_path.exists():
            shutil.copy2(bak_path, orig_path)
            p(f"  {col(C.G, '✓')} Restored {orig_path.name}")
        else:
            p(f"  {col(C.Y, '!')} Backup not found: {bak_path.name} — skipped")

    for f in files_added:
        fp = pathlib.Path(f)
        if fp.exists():
            fp.unlink()
            p(f"  {col(C.G, '✓')} Removed {fp.name}")

    # Also clean up debug mode if active (not tracked in manifest)
    debug_file = pathlib.Path.home() / ".claude" / "rules" / "claude-kit-debug.md"
    if debug_file.exists():
        debug_file.unlink()
        p(f"  {col(C.G, '✓')} Removed claude-kit-debug.md (debug mode was on)")

    MANIFEST_FILE.unlink(missing_ok=True)

    p()
    p(f"  {col(C.G, 'Restore complete.')} All setup changes reverted.")
    p()

