# Copy this file to .env before running docker-compose
# cp env.example .env

# Database
DATABASE_URL=postgresql+asyncpg://claudekit:localdev@postgres:5432/claudekit

# JWT
JWT_SECRET=change-me-generate-a-real-secret
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# OAuth (optional — leave empty to disable)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Application
APP_NAME=claude-kit-api
DEBUG=false
LOG_LEVEL=INFO
