{
  "name": "claude-kit",
  "image": "ghcr.io/mateosegura/dev-env-claude-kit:latest",

  // .env loaded automatically via --env-file (GITHUB_TOKEN, IS_SANDBOX)
  "runArgs": ["--init", "--env-file", ".devcontainer/.env"],

  "mounts": [
    // Inherit host Claude credentials, config, and local plugins
    "source=${localEnv:HOME}/.claude,target=/root/.claude,type=bind,consistency=cached",
    // Docker-outside-of-Docker: mount host Docker socket
    "source=/var/run/docker.sock,target=/var/run/docker.sock,type=bind",
    // Persist Go module cache across rebuilds
    "source=claude-kit-gomodcache,target=/go/pkg/mod,type=volume"
  ],

  "postCreateCommand": "/workspace/.devcontainer/ctl.sh post-create",
  "postStartCommand": "/workspace/.devcontainer/ctl.sh post-start",

  "workspaceFolder": "/workspace",
  "workspaceMount": "source=${localWorkspaceFolder},target=/workspace,type=bind,consistency=cached",

  "customizations": {
    "vscode": {
      "settings": {
        "terminal.integrated.defaultProfile.linux": "zsh",
        "python.defaultInterpreterPath": "/usr/bin/python3",
        "go.gopath": "/go",
        "go.goroot": "/usr/local/go",
        "editor.formatOnSave": true,
        "[python]": {
          "editor.defaultFormatter": "charliermarsh.ruff"
        },
        "[go]": {
          "editor.defaultFormatter": "golang.go"
        }
      },
      "extensions": [
        "ms-python.python",
        "charliermarsh.ruff",
        "golang.go",
        "timonwong.shellcheck",
        "redhat.vscode-yaml",
        "github.vscode-pull-request-github",
        "ms-azuretools.vscode-docker",
        "eamodio.gitlens",
        "usernamehw.errorlens"
      ]
    }
  },

  "forwardPorts": [],
  "features": {}
}
