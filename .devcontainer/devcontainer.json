{
  "name": "claude-kit",
  "image": "ghcr.io/mateosegura/dev-env-claude-kit:latest",

  // Privileged for Docker-in-Docker; root user throughout
  "runArgs": ["--privileged", "--init"],

  // Pass host env vars into the container (set by ctl.sh from .env)
  "containerEnv": {
    "GITHUB_TOKEN": "${localEnv:GITHUB_TOKEN}",
    "IS_SANDBOX": "${localEnv:IS_SANDBOX}"
  },

  "mounts": [
    // Inherit host Claude credentials, config, and local plugins
    "source=${localEnv:HOME}/.claude,target=/root/.claude,type=bind,consistency=cached",
    // Persist Go module cache across rebuilds
    "source=claude-kit-gomodcache,target=/go/pkg/mod,type=volume"
  ],

  // One-time setup: link claude-kit CLI into PATH
  "postCreateCommand": "ln -sf /workspace/claude-kit /usr/local/bin/claude-kit && echo '[devcontainer] claude-kit linked'",

  // Every start: Docker daemon + gh/ghcr auth from GITHUB_TOKEN
  "postStartCommand": "dockerd < /dev/null > /tmp/dockerd.log 2>&1 & timeout 30 sh -c 'until docker info > /dev/null 2>&1; do sleep 1; done' && echo \"$GITHUB_TOKEN\" | gh auth login --with-token 2>/dev/null && echo \"$GITHUB_TOKEN\" | docker login ghcr.io -u MateoSegura --password-stdin 2>/dev/null && echo '[devcontainer] Ready — Docker, gh, ghcr.io authenticated'",

  "workspaceFolder": "/workspace",
  "workspaceMount": "source=${localWorkspaceFolder},target=/workspace,type=bind,consistency=cached",

  "customizations": {
    "vscode": {
      "settings": {
        "terminal.integrated.defaultProfile.linux": "bash",
        "python.defaultInterpreterPath": "/usr/bin/python3",
        "go.gopath": "/go",
        "go.goroot": "/usr/local/go",
        "editor.formatOnSave": true,
        "[python]": {
          "editor.defaultFormatter": "charliermarsh.ruff"
        },
        "[go]": {
          "editor.defaultFormatter": "golang.go"
        }
      },
      "extensions": [
        "ms-python.python",
        "charliermarsh.ruff",
        "golang.go",
        "timonwong.shellcheck",
        "redhat.vscode-yaml",
        "github.vscode-pull-request-github",
        "ms-azuretools.vscode-docker",
        "eamodio.gitlens",
        "usernamehw.errorlens"
      ]
    }
  },

  "forwardPorts": [],
  "features": {}
}
