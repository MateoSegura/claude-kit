# ── claude-kit devcontainer environment ──────────────────────────────────────
#
# Copy this file to .devcontainer/.env and fill in your values.
# .env is gitignored — it never leaves your machine.
#
#   cp .devcontainer/.env.example .devcontainer/.env
#
# The ctl.sh script reads this file before creating or starting the container.

# GitHub personal access token
# Scopes needed: repo, packages:write (for ghcr.io push), read:org
GITHUB_TOKEN=

# Allow Claude Code to run as root inside the container.
# Must be set to 1 — Claude refuses to run as root without this.
IS_SANDBOX=1
